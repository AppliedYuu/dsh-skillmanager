{
  "name": "dsh-skillmanager",
  "version": "0.3.0",
  "description": "DSH web plugin: 在「设置 → 固定提示词」里管理存放在 Obsidian 仓库 skills/ 文件夹中的技能笔记（读取/修改/启停/创建/删除/导入 + 可改仓库地址），并在单个对话里为当前对话单独开关技能（含默认未启用的）。启用的技能内容会在每次模型请求时自动注入系统提示。",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "scripts": {
    "test": "node test/smoke.mjs && node test/client.mjs",
    "smoke": "node test/smoke.mjs",
    "client-test": "node test/client.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-slots"
      ]
    }
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "cordis.patch.yml",
    "README.md"
  ],
  "peerDependencies": {
    "@deepseek-ai/dsh-client-runtime": "^0.1.0-rc.7",
    "@deepseek-ai/dsh-client-ui-slots": "^0.1.0-rc.7",
    "react": "^18.2.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "license": "MIT"
}
